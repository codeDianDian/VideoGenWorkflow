# Pick ONE LLM provider (Codex equivalent). Uncomment the block you want.

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# VIDFORGE_LLM_PROVIDER=anthropic
# VIDFORGE_LLM_MODEL=claude-sonnet-4-5

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# VIDFORGE_LLM_PROVIDER=openai
# VIDFORGE_LLM_MODEL=gpt-4o

# --- DeepSeek (OpenAI-compatible; cheapest of the three) ---
# Get a key at https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1   # optional override
# VIDFORGE_LLM_PROVIDER=deepseek
# VIDFORGE_LLM_MODEL=deepseek-chat                # or deepseek-reasoner for R1

# Default if you do nothing:
ANTHROPIC_API_KEY=sk-ant-...
VIDFORGE_LLM_PROVIDER=anthropic
VIDFORGE_LLM_MODEL=claude-sonnet-4-5

# Optional - HyperFrames render service (heygen-com/hyperframes)
LIBTV_ACCESS_KEY=

# Output video format
VIDFORGE_WIDTH=1080
VIDFORGE_HEIGHT=1920
VIDFORGE_FPS=30
VIDFORGE_DEFAULT_DURATION=60

# Renderer: "hyperframes" or "playwright"
VIDFORGE_RENDERER=playwright

# TTS voice for auto narration (when no human口播 supplied)
# zh-CN-XiaoxiaoNeural | zh-CN-YunxiNeural | en-US-AriaNeural ...
VIDFORGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
