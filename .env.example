# Pick ONE LLM provider. Defaults in code are DeepSeek V4 Flash; set keys below.

# --- DeepSeek (OpenAI-compatible; default) ---
# https://platform.deepseek.com/api_keys — keep base_url unless you use a proxy.
# Use either name; `DEEPSEEK_API_KEY` is the usual choice.
DEEPSEEK_API_KEY=sk-...
# VIDFORGE_DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
VIDFORGE_LLM_PROVIDER=deepseek
# Default in code is deepseek-v4-flash (lower latency); use deepseek-v4-pro for max quality.
# VIDFORGE_LLM_MODEL=deepseek-v4-pro
VIDFORGE_LLM_MODEL=deepseek-v4-flash

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# VIDFORGE_LLM_PROVIDER=anthropic
# VIDFORGE_LLM_MODEL=claude-sonnet-4-5

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# VIDFORGE_LLM_PROVIDER=openai
# VIDFORGE_LLM_MODEL=gpt-4o

# --- Optional: keyframe text-to-image for the post-production tuner ---
# Reuses OPENAI_API_KEY by default, or set a dedicated image key.
# VIDFORGE_IMAGE_API_KEY=sk-...
# VIDFORGE_IMAGE_MODEL=gpt-image-1
# VIDFORGE_IMAGE_SIZE=1024x1792
# Generic OpenAI-like JSON image endpoint; response may contain data[0].b64_json or data[0].url.
# VIDFORGE_IMAGE_API_URL=https://example.com/v1/images/generations

# Optional - HyperFrames render service and LibTV Agent-IM (libtv-skills scripts)
LIBTV_ACCESS_KEY=
# When false, do not append LibTV skill note to per-scene LLM prompts during `vidforge build`
# VIDFORGE_LIBTV_SKILL_IN_SCENE_PROMPT=false

# Optional: max seconds per LLM HTTP request (plan + each scene). Fail fast vs long hangs.
# VIDFORGE_LLM_HTTP_TIMEOUT_S=90

# Build stage: parallel LLM calls for scenes (default 4). Lower if you see 429s; raise on high quota accounts.
# VIDFORGE_BUILD_CONCURRENCY=4
# Per-scene max output tokens (default 8192). Lower can speed up API slightly but may truncate rich scenes / trigger retries.
# VIDFORGE_SCENE_MAX_TOKENS=8192

# Streamlit 工作台轮询 manifest / 构建进度间隔（秒），默认 1；可设 0.5–2 平衡刷新与负载
# VIDFORGE_UI_POLL_S=1

# Plan stage: widen segment windows so heuristic TTS length fits (after LLM returns).
# Set to 0 to only use prompt heuristics (no timeline extension; target duration stays exact).
# VIDFORGE_PLAN_EXPAND_TTS=1
# Extra seconds reserved vs segment window when estimating TTS fit (similar to post_tune guard_gap).
# VIDFORGE_PLAN_TTS_GUARD_S=0.14
# Conservative speaking-rate heuristics (lower = more aggressive timeline extension).
# VIDFORGE_PLAN_TTS_CHARS_PER_SEC_ZH=3.6
# VIDFORGE_PLAN_TTS_WORDS_PER_SEC_EN=2.3

# Output video format
VIDFORGE_WIDTH=1080
VIDFORGE_HEIGHT=1920
VIDFORGE_FPS=30
VIDFORGE_DEFAULT_DURATION=60

# Renderer: "hyperframes" or "playwright"
VIDFORGE_RENDERER=playwright
# Playwright only: max wait for dataset.ready before GSAP starts (ms); increase if render times out early
# VIDFORGE_PLAYWRIGHT_READY_TIMEOUT_MS=120000
# Waiting for dataset.done: extra seconds after max(plan duration, last segment end), plus minimum ms floor
# VIDFORGE_PLAYWRIGHT_DONE_BUFFER_S=120
# VIDFORGE_PLAYWRIGHT_DONE_TIMEOUT_FLOOR_MS=240000

# TTS voice for auto narration (when no human口播 supplied)
# zh-CN-XiaoxiaoNeural | zh-CN-YunxiNeural | en-US-AriaNeural ...
VIDFORGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
