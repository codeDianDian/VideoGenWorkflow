:root {
  --stage-w: {{ width }}px;
  --stage-h: {{ height }}px;
  --bg: #0e1116;
  --fg: #f6f7fb;
  --accent: #4f8cff;
  --muted: #9aa3b2;
  --safe-bottom: 380px;
}

html, body {
  margin: 0;
  padding: 0;
  background: #000;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
  color: var(--fg);
  overflow: hidden;
}

#stage {
  position: relative;
  width: var(--stage-w);
  height: var(--stage-h);
  margin: 0 auto;
  background: linear-gradient(160deg, #0c1118 0%, #161c26 100%);
  overflow: hidden;
}

.scene {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  padding: 96px 80px var(--safe-bottom);
  box-sizing: border-box;
}

.scene.is-active {
  visibility: visible;
  /* Must override .scene { opacity: 0 } — otherwise children stay fully transparent (black “empty” stage). */
  opacity: 1;
}

#vf-subtitle {
  position: absolute;
  left: 60px;
  right: 60px;
  bottom: 240px;
  font-size: 56px;
  font-weight: 700;
  text-align: center;
  line-height: 1.25;
  text-shadow: 0 4px 24px rgba(0,0,0,0.6);
  letter-spacing: 0.02em;
  max-width: 960px;
  text-wrap: balance;
}

#pip-safe-zone,
#progress {
  display: none;
}

{{ scene_styles }}

/* Generated scene CSS often targets `.scene-N` directly. Keep the root scene
   layers locked to the stage so those rules cannot push active scenes below
   the viewport. */
.scene {
  position: absolute !important;
  inset: 0 !important;
  width: var(--stage-w) !important;
  height: var(--stage-h) !important;
  margin: 0 !important;
}
